# ── service-ai — AI Metadata Worker ─────────────────────────────────────────
# Phase 3 / v2.4.0-ALPHA.42-PRO
FROM python:3.12-slim-bookworm

# System dependencies: ffmpeg for silence detection + libpq for psycopg2
# Force HTTPS for all apt sources — port 80 (HTTP) is blocked on some servers/providers
RUN if [ -f /etc/apt/sources.list.d/debian.sources ]; then \
      sed -i 's|URIs: http://|URIs: https://|g' /etc/apt/sources.list.d/debian.sources; \
    else \
      sed -i 's|http://deb.debian.org|https://deb.debian.org|g' /etc/apt/sources.list; \
      sed -i 's|http://security.debian.org|https://security.debian.org|g' /etc/apt/sources.list; \
    fi

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    libpq5 \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Python dependencies (cached layer)
COPY service-ai/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# Application source
COPY service-ai/worker.py ./

# Non-root user
RUN useradd -m aiworker
USER aiworker

# No port exposed — worker is poll-based, no HTTP
# Healthcheck via Redis/DB connectivity is handled at app startup

ENV WHISPER_MODEL=base \
    POLL_INTERVAL=15

CMD ["python", "-u", "worker.py"]
