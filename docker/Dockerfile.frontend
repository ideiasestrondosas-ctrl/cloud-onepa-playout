# Build stage
FROM node:20-alpine as builder

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
ENV NODE_ENV=development
# Cache buster to force a clean install if needed
ARG CACHE_BUST=1
RUN npm cache clean --force && \
    npm install --include=dev --loglevel info && \
    npm list --depth=0

# Copy source code
COPY . .

# Diagnostic: Extremely verbose binary check
RUN echo "Checking bin directory content..." && \
    ls -la node_modules/.bin/ && \
    find node_modules -name vite -type f -executable

# Build application with direct binary call and forced environment
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL
RUN ./node_modules/.bin/vite build --logLevel info

# Diagnostic: verify dist directory
RUN ls -d /app/dist && ls -la /app/dist || (echo "FATAL: dist folder not found!" && exit 1)

# Production stage
FROM nginx:alpine

# Copy built files
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy nginx configuration
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
