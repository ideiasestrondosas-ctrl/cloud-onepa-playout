# Build stage
FROM node:20-alpine as builder

# Absolute start with space check
RUN echo "BUILD START - DISK STATUS:" && df -h

WORKDIR /app

# Copy package files
COPY package*.json ./

# Force non-cached dependency install using the CACHE_BUST argument
ARG CACHE_BUST=1
RUN echo "FORCE REBUILD TRIGGER: $CACHE_BUST" && \
    npm cache clean --force && \
    (npm ci --include=dev --loglevel warn || npm install --include=dev --no-audit) && \
    ls -la node_modules/.bin/vite

# Copy source code
COPY . .

# Diagnostic: Verify source integrity
RUN echo "SOURCE STATUS:" && ls -laR | grep -v node_modules | head -n 50

# Build application with raw error capture and env audit
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL

RUN echo "ENVIRONMENT AUDIT:" && env | grep -E "VITE|NODE" && \
    echo "FILE STRUCTURE AUDIT:" && ls -la && \
    set -e; \
    echo "Starting deterministic Vite build..." && \
    ./node_modules/.bin/vite build --logLevel info

# Final Forensic Check
RUN echo "BUILD FINISHED - OUTPUT VERIFICATION:" && \
    ls -d /app/dist && \
    ls -la /app/dist && \
    [ "$(ls -A /app/dist)" ] || (echo "FATAL: dist folder IS EMPTY!" && exit 1)

# Production stage
FROM nginx:alpine

# Copy built files from builder
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy nginx configuration
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
