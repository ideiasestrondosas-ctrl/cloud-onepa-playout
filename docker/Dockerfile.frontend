# Build stage
FROM node:20-alpine as builder

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
ENV NODE_ENV=development
RUN npm install

# Copy source code
COPY . .

# Build application
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL

# Diagnostic: check dependencies
RUN ls -la node_modules/.bin/vite || (echo "Vite not found!" && exit 1)

# Run build with verbose output
RUN npm run build -- --logLevel info

# Diagnostic: verify output
RUN ls -la /app/dist || (echo "Build failed: dist folder not created!" && exit 1)

# Production stage
FROM nginx:alpine

# Copy built files
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy nginx configuration
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
