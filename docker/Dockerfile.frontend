# Build stage
FROM node:20-alpine as builder

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
ENV NODE_ENV=development
# Aggressive install including devDependencies
RUN npm install --include=dev && npm list --depth=0

# Copy source code
COPY . .

# Diagnostic: check Vite binary existence
RUN ls -la node_modules/.bin/vite || (echo "Vite binary MISSING after install!" && exit 1)

# Build application with forced binary path and verbose logging
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL
RUN ./node_modules/.bin/vite build --logLevel info

# Diagnostic: verify dist directory
RUN ls -la /app/dist && [ -d "/app/dist" ] || (echo "Build failed: dist folder not created!" && exit 1)

# Production stage
FROM nginx:alpine

# Copy built files
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy nginx configuration
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
