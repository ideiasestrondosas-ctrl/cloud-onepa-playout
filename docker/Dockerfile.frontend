# Build stage
FROM node:20-alpine as builder

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
ENV NODE_ENV=development
ARG CACHE_BUST=1

# Verify context and lockfile
RUN cat package.json | grep -E '"name"|"version"'

# Clean install with deterministic lockfile usage
RUN npm ci --include=dev --loglevel warn || npm install --include=dev

# Copy source code
COPY . .

# Build application with multi-layer fallback
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL

RUN if [ -f "./node_modules/.bin/vite" ]; then \
    echo "Using local Vite binary..." && \
    ./node_modules/.bin/vite build --logLevel info; \
    else \
    echo "Local Vite missing! Falling back to npx..." && \
    npx --yes vite build --logLevel info; \
    fi

# Final verification of output
RUN [ -d "/app/dist" ] && ls -la /app/dist || (echo "FATAL: Build failed to produce dist directory!" && exit 1)

# Production stage
FROM nginx:alpine

# Copy built files
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy nginx configuration
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
