      "clock_config_intro": "Personalice la apariencia y el comportamiento de la capa de reloj.",
      "clock_format": "Formato de Hora",
      "clock_format_desc": "Elija entre 24h (HH:mm:ss) o 12h (hh:mm:ss AM/PM), con o sin segundos.",
