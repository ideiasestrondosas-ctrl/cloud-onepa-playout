    "graphics": {
      "title": "Editor Gráfico",
      "intro": "El Editor Gráfico le permite crear y gestionar superposiciones visuales, logotipos y capas animadas para sus transmisiones en vivo.",
      "features_title": "Características Principales",
      "features_intro": "El Editor Gráfico ofrece herramientas profesionales para la producción de gráficos de transmisión:",
      "feature1": "Posicionamiento preciso de logotipos y gráficos con soporte para múltiples puntos de anclaje",
      "feature2": "Control total de escala, opacidad y rotación para cada elemento gráfico",
      "feature3": "Sistema de capas para organizar superposiciones complejas con control individual",
      "feature4": "Integración con biblioteca de plantillas para reutilización rápida de diseños",
      "feature5": "Soporte para múltiples capas de texto, imágenes, formas y animaciones",
      "feature6": "Vista previa en tiempo real con previsualización de salida 16:9",
      "position_tab_title": "Pestaña Posición",
      "position_tab_intro": "Controle la posición exacta de los elementos gráficos en la pantalla de transmisión.",
      "anchor_point": "Punto de Anclaje",
      "anchor_point_desc": "Seleccione una de las 4 esquinas (superior-izquierda, superior-derecha, inferior-izquierda, inferior-derecha) como referencia de posicionamiento.",
      "offset_x": "Offset X (Horizontal)",
      "offset_x_desc": "Ajuste fino de la posición horizontal en píxeles (0-1920). Use el control deslizante o arrastre el logotipo en la vista previa.",
      "offset_y": "Offset Y (Vertical)",
      "offset_y_desc": "Ajuste fino de la posición vertical en píxeles (0-1080). Use el control deslizante o arrastre el logotipo en la vista previa.",
      "drag_drop": "Arrastrar y Soltar",
      "drag_drop_desc": "Arrastre el logotipo directamente en el área de vista previa para un posicionamiento intuitivo en tiempo real.",
      "style_tab_title": "Pestaña Estilo",
      "style_tab_intro": "Ajuste las propiedades visuales como tamaño y transparencia de los elementos gráficos.",
      "scale": "Escala",
      "scale_desc": "Controla el tamaño del logotipo (10%-300%). El valor representa el porcentaje del ancho de la pantalla de salida.",
      "opacity": "Opacidad",
      "opacity_desc": "Controla la transparencia del elemento (10%-100%). Se recomiendan valores por debajo del 80% para superposiciones no intrusivas.",
      "layer_tab_title": "Pestaña Capa",
